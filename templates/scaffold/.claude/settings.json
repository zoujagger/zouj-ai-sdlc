{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "zouj": {
      "source": {
        "source": "github",
        "repo": "zoujagger/zouj-ai-sdlc"
      }
    }
  },
  "enabledPlugins": {
    "zouj-ai-sdlc@zouj": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(make deploy ENV=prod*)",
      "Bash(make rollback ENV=prod*)",
      "Bash(gh pr merge*)"
    ]
  }
}
